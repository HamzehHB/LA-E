# ==========================================
# LivingAuthenticity Environment
# ==========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ---------- Virtual Environment ----------
Venv/

# ---------- Environment ----------
.env

# ---------- Local machine configuration ----------
Config/paths.local.yaml

# ---------- Local LLM provider configuration (may hold credentials) ----------
Config/llm.local.yaml

# ---------- IDE ----------
.vscode/
.clinerules/

# ---------- Logs ----------
Logs/*
!Logs/.gitkeep

# ---------- Cache ----------
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- LanceDB ----------
*.lance/

# ---------- Temporary ----------
*.tmp
*.bak

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Packaging ----------
dist/
build/
*.egg-info/

# ---------- Test outputs ----------
tests/output/
tests/temp/

# ---------- Local-only tests (never tracked) ----------
tests/local/

# ---------- Private Project Documents ----------
.project/

# ---------- Frontend ----------
frontend/node_modules/
frontend/dist/
frontend/*.log