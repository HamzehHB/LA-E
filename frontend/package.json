    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.0",
    "vitest": "3.2.0"
  }
}
